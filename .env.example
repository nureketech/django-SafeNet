# SafeNet KZ — production settings. Copy to `.env` (never commit it) and fill in.
# Variables already set in the environment take precedence over this file.
# Full guide: docs/DEPLOYMENT.md

SAFENET_ENV=production

# 50+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# host names the service answers to (comma-separated)
DJANGO_ALLOWED_HOSTS=safenet.example.kz
# full origins used in the browser (needed behind HTTPS / a reverse proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=https://safenet.example.kz

# HTTPS: secure cookies, HSTS, redirect to https. Set 0 only for an isolated test stand without TLS.
SAFENET_HTTPS=1
# TLS terminated by nginx / IIS in front of the app (trust X-Forwarded-Proto / -For)
SAFENET_BEHIND_PROXY=1

# Database: sqlite (default, single server) or postgresql (pip install -r requirements-prod.txt)
SAFENET_DB_ENGINE=postgresql
SAFENET_DB_NAME=safenet
SAFENET_DB_USER=safenet
SAFENET_DB_PASSWORD=
SAFENET_DB_HOST=localhost
SAFENET_DB_PORT=5432
# SQLite file when SAFENET_DB_ENGINE=sqlite
# SAFENET_DB=/var/lib/safenet/safenet.sqlite3

# Sessions and sign-in protection
SAFENET_SESSION_HOURS=8
SAFENET_LOGIN_MAX_FAILURES=5
SAFENET_LOGIN_LOCK_MINUTES=15

# API: requests per token
SAFENET_API_RATE=600/m

# Files
SAFENET_LOG_DIR=/var/log/safenet
SAFENET_FEEDBACK_PATH=/var/lib/safenet/feedback.csv

# Example texts on the check page (demonstrations only)
SAFENET_DEMO_MODE=0
